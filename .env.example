PORT=8787
HTTP_TIMEOUT_MS=15000
CACHE_TTL_MS=60000

# Optional. Public CoinGecko responses are used when this is empty.
COINGECKO_API_KEY=

# Optional remote catalog. When empty, data/assets.json is used.
# The catalog is loaded with axios.get.
ASSET_CATALOG_URL=

FRANKFURTER_BASE=https://api.frankfurter.app
TREASURY_BASE=https://api.fiscaldata.treasury.gov/services/api/fiscal_service
COINGECKO_BASE=https://api.coingecko.com/api/v3
